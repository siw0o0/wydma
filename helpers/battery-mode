#!/bin/sh
# Tryb ładowania baterii: long (ok. 80%), standard albo fast (do 100%). Kod 0 po potwierdzeniu odczytem.
set -e
f=/sys/class/power_supply/BAT0/charge_types
case "$1" in
  long) v=Long_Life ;;
  standard) v=Standard ;;
  fast) v=Fast ;;
  *) echo "użycie: battery-mode long|standard|fast" >&2; exit 2 ;;
esac
printf '%s' "$v" > "$f"
grep -q "\[$v\]" "$f"
